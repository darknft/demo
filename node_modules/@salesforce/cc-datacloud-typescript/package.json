{
  "name": "@salesforce/cc-datacloud-typescript",
  "version": "1.1.2",
  "description": "Code to generate typescript types from openapi specs",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib":"./src/lib/index.js",
    "./models": "./src/lib/models/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:lib": "npm run build && rollup -c",
    "clean": "rm -rf build src/**/*/*.js src/**/*/*.d.ts test/*.js test/*.d.ts src/*.js src/*.d.ts src/lib/models/**/*.js src/lib/models/**/*.d.ts",
    "doc": "npm run doc:generate",
    "doc:generate":"typedoc" ,
    "test": "yarn run test:unit",
    "test:unit": "jest --coverage --no-experiemental-fetch --testPathIgnorePatterns node_modules src/lib"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "headers-polyfill": "^4.0.2",
    "openapi-fetch": "^0.8.2",
    "rollup": "^2.79.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.8",
    "@babel/preset-typescript": "^7.23.3",
    "@convergencelabs/typedoc-plugin-custom-modules": "^0.4.0",
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "10.4.9",
    "@types/babel__core": "^7",
    "@types/js-yaml": "^4.0.9",
    "@types/node-fetch": "^2.6.11",
    "app-root-path": "^3.1.0",
    "autoprefixer": "10.4.16",
    "jest": "^29.7.0",
    "lint-staged": "15.2.0",
    "nock": "^13.5.0",
    "node-fetch": "2.7.0",
    "npm-pack-all": "^1.12.7",
    "openapi-typescript": "^6.7.3",
    "postcss-preset-env": "9.3.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "snyk": "^1.1269.0",
    "sort-package-json": "^2.6.0",
    "stylelint": "16.1.0",
    "stylelint-config-standard": "36.0.0",
    "stylelint-order": "6.0.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.12",
    "typedoc-plugin-external-module-map": "^2.0.1",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=18"
  }
}
